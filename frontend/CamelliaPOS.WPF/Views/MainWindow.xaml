<Window x:Class="CamelliaPOS.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Camellia Café &amp; Restaurant - POS System" 
        Height="900" Width="1600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#8B4513" Padding="10">
            <DockPanel>
                <DockPanel.Resources>
                    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                </DockPanel.Resources>
                <TextBlock Text="☕ CAMELLIA CAFÉ &amp; RESTAURANT - POS SYSTEM" 
                          FontSize="24" FontWeight="Bold" 
                          Foreground="White" 
                          VerticalAlignment="Center"
                          DockPanel.Dock="Left"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right"
                            Visibility="{Binding CanAccessAdmin, Converter={StaticResource BoolToVis}}">
                    <Button Content="Settings"
                            Margin="0,0,5,0"
                            Command="{Binding Admin.OpenSettingsCommand}"/>
                    <Button Content="Inventory"
                            Margin="0,0,5,0"
                            Command="{Binding Admin.OpenInventoryCommand}"/>
                    <Button Content="Analytics"
                            Margin="0,0,5,0"
                            Command="{Binding Admin.OpenAnalyticsCommand}"/>
                    <Button Content="Low Stock"
                            Margin="0,0,5,0"
                            Command="{Binding Admin.OpenLowStockCommand}"/>
                    <Button Content="Backup"
                            Margin="0,0,5,0"
                            Command="{Binding Admin.CreateBackupCommand}"/>
                    <Button Content="Restore"
                            Margin="0,0,5,0"
                            Command="{Binding Admin.RestoreBackupCommand}"/>
                    <Button Content="Export CSV"
                            Margin="0,0,5,0"
                            Command="{Binding Admin.ExportCsvCommand}"/>
                    <TextBlock x:Name="TimeDisplay"
                               FontSize="14" 
                               Foreground="White" 
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            
            <!-- Category Sidebar -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Icon}" 
                                       Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       Height="80" FontSize="32"
                                       Margin="5"
                                       Background="{Binding Color, Converter={StaticResource StringToBrushConverter}}"
                                       Foreground="White"
                                       ToolTip="{Binding Name}"
                                       Cursor="Hand"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            
            <!-- Menu Items Grid -->
            <Border Grid.Column="1" Margin="10">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" Rows="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" 
                                       Background="White" CornerRadius="5"
                                       MouseLeftButtonDown="MenuItem_Click">
                                    <StackPanel>
                                        <Border Height="120" Background="LightGray" Margin="5">
                                            <Grid>
                                                <TextBlock Text="📷" FontSize="48" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding ImagePath, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                <Image Source="{Binding ImagePath}" 
                                                      Height="120" 
                                                      Stretch="UniformToFill"
                                                      Margin="0"
                                                      Visibility="{Binding ImagePath, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" 
                                                  FontSize="16" FontWeight="Bold"
                                                  HorizontalAlignment="Center" 
                                                  Margin="5,5,5,0"/>
                                        <TextBlock Text="{Binding Price, StringFormat='Rs {0:F2}'}" 
                                                  FontSize="18" Foreground="#8B4513" FontWeight="Bold"
                                                  HorizontalAlignment="Center" 
                                                  Margin="5,0,5,5"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            
            <!-- Billing Panel -->
            <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1,0,0,0" Background="#F5F5F5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Cart Header -->
                    <Border Grid.Row="0" Background="#8B4513" Padding="15">
                        <TextBlock Text="CART" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    
                    <!-- Cart Items -->
                    <ScrollViewer Grid.Row="1" Margin="10">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding MenuItem.Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat='Rs {0:F2}'}" FontSize="12" Foreground="Gray"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                                                <Button Content="-" Width="30" Height="30" 
                                                       Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Quantity}" 
                                                          Width="40" 
                                                          TextAlignment="Center" 
                                                          VerticalAlignment="Center"
                                                          FontSize="16" FontWeight="Bold"/>
                                                <Button Content="+" Width="30" Height="30"
                                                       Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="2" 
                                                      Text="{Binding TotalPrice, StringFormat='Rs {0:F2}'}" 
                                                      FontWeight="Bold" 
                                                      VerticalAlignment="Center"
                                                      Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Totals -->
                    <Border Grid.Row="2" Background="White" Padding="15" Margin="10">
                        <StackPanel>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal:" Grid.Column="0"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat='Rs {0:F2}'}" 
                                          Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                            
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Discount:" Grid.Column="0"/>
                                <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="100" HorizontalAlignment="Right" Grid.Column="1"/>
                            </Grid>
                            
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tax:" Grid.Column="0"/>
                                <TextBox Text="{Binding Tax, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="100" HorizontalAlignment="Right" Grid.Column="1"/>
                            </Grid>
                            
                            <Separator Margin="0,10"/>
                            
                            <Grid Margin="0,5">
                                <TextBlock Text="TOTAL:" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Total, StringFormat='Rs {0:F2}'}" 
                                          HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#8B4513"/>
                            </Grid>
                            
                            <ComboBox SelectedIndex="{Binding PaymentMethod}" Margin="0,10">
                                <ComboBoxItem Content="Cash"/>
                                <ComboBoxItem Content="Card"/>
                            </ComboBox>
                            
                            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" 
                                    materialDesign:HintAssist.Hint="Paid Amount"
                                    Margin="0,5" FontSize="16"/>
                            
                            <Grid Margin="0,10">
                                <TextBlock Text="BALANCE:" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Balance, StringFormat='Rs {0:F2}'}" 
                                          HorizontalAlignment="Right" FontSize="16" FontWeight="Bold" Foreground="Green"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Margin="10" Orientation="Horizontal">
                        <Button Content="CLEAR" 
                               Command="{Binding ClearCartCommand}"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Width="120" Height="50" Margin="0,0,10,0"/>
                        <Button Content="PAY" 
                               Command="{Binding ProcessPaymentCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Background="#8B4513" Foreground="White"
                               Width="120" Height="50" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

