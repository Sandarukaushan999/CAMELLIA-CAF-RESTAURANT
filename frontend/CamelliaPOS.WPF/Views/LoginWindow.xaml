<Window x:Class="CamelliaPOS.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Camellia Café &amp; Restaurant - Login" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#8B4513" Padding="20">
                        <TextBlock Text="☕ CAMELLIA CAFÉ &amp; RESTAURANT"
                      FontSize="24" FontWeight="Bold" 
                      Foreground="White" 
                      HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Login Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="40">
            <TextBlock Text="POS System Login" 
                      FontSize="20" FontWeight="Bold" 
                      Margin="0,0,0,30" 
                      HorizontalAlignment="Center"/>
            
            <TextBox materialDesign:HintAssist.Hint="Username" 
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     FontSize="16" Margin="0,0,0,20"/>
            
            <PasswordBox materialDesign:HintAssist.Hint="Password"
                        x:Name="PasswordBox"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                        FontSize="16" Margin="0,0,0,20"/>
            
            <TextBlock Text="{Binding ErrorMessage}" 
                      Foreground="Red" 
                      Margin="0,0,0,20"
                      TextWrapping="Wrap"
                      Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            
            <Button Content="LOGIN" 
                   Command="{Binding LoginCommand}"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Height="50" FontSize="16" FontWeight="Bold"
                   Background="#8B4513" Foreground="White"
                   IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
            
            <TextBlock Text="System by VOXOsolution" 
                      FontSize="10" 
                      Foreground="Gray" 
                      HorizontalAlignment="Center" 
                      Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>

